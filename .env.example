# Copy to .env and fill in. Dry-run demo needs nothing.
# Live agent needs ONE of: OPENAI_API_KEY or OLLAMA_MODEL.

# LLM provider (live mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# LLM observability (Langfuse self-host, optional — no-op when unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Cluster
KUBECONFIG=
K8S_NAMESPACE=streaming-demo
K8S_DRY_RUN=false

# RAG
CHROMA_DIR=data/chroma
RAG_TOP_K=4

# Safety
ABSTAIN_THRESHOLD=0.55
REQUIRE_APPROVAL=true
